{
  "name": "connectsphere",
  "version": "1.0.0",
  "private": true,
  "description": "ConnectSphere - Professional Networking Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "build": "npm run build --workspace=packages/shared-types && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "db:server": "node scripts/db-server.js",
    "db:migrate": "npx prisma migrate dev --schema=./prisma/schema.prisma",
    "db:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio --schema=./prisma/schema.prisma",
    "db:reset": "npx prisma migrate reset --schema=./prisma/schema.prisma"
  },
  "devDependencies": {
    "@prisma/client": "^5.10.0",
    "concurrently": "^8.2.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^5.10.0",
    "typescript": "^5.3.3"
  }
}
