# Environment Configuration Template for ConnectSphere

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────
DB_PASSWORD=cs_secret_password
DATABASE_URL=postgresql://cs_user:cs_secret_password@localhost:5432/connectsphere

# ─────────────────────────────────────────
# Redis (Cache, Sessions, WebSockets)
# ─────────────────────────────────────────
REDIS_PASSWORD=cs_redis_secret
REDIS_URL=redis://:cs_redis_secret@localhost:6379

# ─────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────
JWT_SECRET=cs_super_secret_jwt_key_development_2026_at_least_64_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cs_super_secret_refresh_key_development_2026_at_least_64_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────
# Python Intelligence Service
# ─────────────────────────────────────────
PYTHON_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_SECRET=cs_internal_service_secret_2026

# ─────────────────────────────────────────
# Frontend Environment (Next.js)
# ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
